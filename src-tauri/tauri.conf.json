{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "personaldashboard",
  "version": "1.0.1",
  "identifier": "it.matteo.personalDashboard",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "personaldashboard",
        "width": 1200,
        "height": 620,
        "minWidth": 1200,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "backgroundColor": "#0b0b0e"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self' https://www.youtube.com",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://i.ytimg.com",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:14321 https://*.supabase.co wss://*.supabase.co https://api.open-meteo.com https://geocoding-api.open-meteo.com https://www.youtube.com",
        "frame-src": "https://www.youtube.com https://www.youtube-nocookie.com",
        "media-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self' 'unsafe-inline' https://www.youtube.com",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://i.ytimg.com",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:5173 http://127.0.0.1:54321 ws://127.0.0.1:54321 https://*.supabase.co wss://*.supabase.co https://api.open-meteo.com https://geocoding-api.open-meteo.com https://www.youtube.com",
        "frame-src": "https://www.youtube.com https://www.youtube-nocookie.com",
        "media-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "filetransfer/public/": "filetransfer-public/"
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "personaldashboard"
        ]
      }
    }
  }
}
