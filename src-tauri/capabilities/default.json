{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permessi dell'app desktop (Windows, macOS, Linux). Android: mobile.json",
  "platforms": ["windows", "macOS", "linux"],
  "windows": ["main"],
  "remote": { "urls": ["http://localhost:14321"] },
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "sql:default",
    "sql:allow-execute",
    "notification:default",
    "dialog:default",
    "opener:default",
    "deep-link:default",
    "allow-ft-start-server",
    "allow-ft-stop-server",
    "allow-ft-status",
    "allow-ft-list-files",
    "allow-ft-read-preview",
    "allow-ft-open-folder",
    "allow-companion-snapshot",
    "allow-notify-with-image",
    "allow-secure-store-get",
    "allow-secure-store-set",
    "allow-secure-store-remove",
    "allow-file-open",
    "allow-file-share",
    "allow-db-export-prepare",
    "allow-db-export-save",
    "allow-db-import-stage",
    "allow-db-import-apply",
    "allow-sysmon-capabilities",
    "allow-sysmon-subscribe",
    "allow-sysmon-unsubscribe",
    "allow-sysmon-reset",
    "allow-sysmon-set-interval",
    "allow-screentime-start",
    "allow-screentime-take",
    "allow-screentime-stop",
    "allow-app-set-close-to-tray",
    "allow-app-quit",
    "allow-tray-set-today",
    "allow-app-launch-at-startup",
    "allow-app-set-launch-at-startup",
    "allow-updater-prepare-install",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "process:allow-restart",
    { "identifier": "opener:allow-open-path", "allow": [{ "path": "$DOCUMENT/Notes" }, { "path": "$DOCUMENT/Notes/**" }] },
    { "identifier": "fs:allow-read-file", "allow": [{ "path": "$DESKTOP/**" }, { "path": "$DOCUMENT/**" }, { "path": "$DOWNLOAD/**" }, { "path": "$PICTURE/**" }, { "path": "$HOME/**" }], "deny": [{ "path": "$APPDATA/**" }, { "path": "$APPCONFIG/**" }, { "path": "$APPLOCALDATA/**" }, { "path": "$HOME/.ssh/**" }, { "path": "$HOME/.gnupg/**" }, { "path": "$HOME/.aws/**" }, { "path": "$HOME/.android-keys/**" }] },
    { "identifier": "fs:allow-read-text-file", "allow": [{ "path": "$DESKTOP/**" }, { "path": "$DOCUMENT/**" }, { "path": "$DOWNLOAD/**" }, { "path": "$PICTURE/**" }, { "path": "$HOME/**" }], "deny": [{ "path": "$APPDATA/**" }, { "path": "$APPCONFIG/**" }, { "path": "$APPLOCALDATA/**" }, { "path": "$HOME/.ssh/**" }, { "path": "$HOME/.gnupg/**" }, { "path": "$HOME/.aws/**" }, { "path": "$HOME/.android-keys/**" }] },
    { "identifier": "fs:allow-read-dir", "allow": [{ "path": "$DOCUMENT/Notes" }, { "path": "$DOCUMENT/Notes/**" }] },
    { "identifier": "fs:allow-exists", "allow": [{ "path": "$DOCUMENT/Notes" }, { "path": "$DOCUMENT/Notes/**" }] },
    { "identifier": "fs:allow-mkdir", "allow": [{ "path": "$DOCUMENT/Notes" }, { "path": "$DOCUMENT/Notes/**" }] },
    { "identifier": "fs:allow-write-file", "allow": [{ "path": "$DOCUMENT/Notes/**" }] },
    { "identifier": "fs:allow-write-text-file", "allow": [{ "path": "$DOCUMENT/Notes/**" }] },
    { "identifier": "fs:allow-rename", "allow": [{ "path": "$DOCUMENT/Notes/**" }] },
    { "identifier": "fs:allow-remove", "allow": [{ "path": "$DOCUMENT/Notes/**" }] }
  ]
}
